# ------------------------------------------------------------------
# Ops Quality Data Gatekeeper — environment configuration
# Copy to .env:   cp .env.example .env
# Leave SMTP values blank to run in safe local fallback mode
# (HTML alert + JSON status saved to data/quarantine/).
# ------------------------------------------------------------------

# Gmail account used to SEND alerts (alerts are always delivered to
# na.vinothkumar2026@gmail.com — configured in src/config.py)
SMTP_SENDER_EMAIL=

# 16-character Gmail App Password (Google Account → Security →
# 2-Step Verification → App passwords). Spaces are stripped automatically.
SMTP_APP_PASSWORD=

# Optional overrides (defaults: smtp.gmail.com over SSL port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
